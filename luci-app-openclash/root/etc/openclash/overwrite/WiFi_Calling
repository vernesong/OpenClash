#!NAME = WiFi_Calling
#!DESC = WiFi Calling (VoWiFi): route carrier ePDG IKE/NAT-T traffic through a UDP-capable proxy group
#!ENV = WIFI_CALLING_PROXY

# These rules match UDP ports 500/4500 and the ePDG domain; raw ESP (IP protocol 50) does not
# match the UDP port rules. Set WIFI_CALLING_PROXY to an existing UDP-capable proxy or group;
# an empty value does not disable the rules. ENABLE_UDP_PROXY controls non-TUN UDP TProxy, while
# STACK_TYPE only affects tun.stack when IPv4/IPv6 TUN or Mix mode enables it. CHINA_IP_ROUTE_PASS
# excludes resolved ePDG addresses from mainland bypass when dnsmasq fills the pass set and
# firewall DNS mode is not 2. The mips stack reassembles fragmented UDP for IPv4/IPv6; the system
# stack does not deliver fragmented datagrams to the UDP handler.
[General]
ENABLE_UDP_PROXY = 1
STACK_TYPE = mips
CHINA_IP_ROUTE_PASS = pub.3gppnetwork.org
CHINA_IP6_ROUTE_PASS = pub.3gppnetwork.org

[YAML]
+rules:
  - AND,((NETWORK,udp),(DST-PORT,500)),${WIFI_CALLING_PROXY:-DIRECT}
  - AND,((NETWORK,udp),(DST-PORT,4500)),${WIFI_CALLING_PROXY:-DIRECT}
  - DOMAIN-SUFFIX,pub.3gppnetwork.org,${WIFI_CALLING_PROXY:-DIRECT}
